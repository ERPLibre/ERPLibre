<?xml version="1.0" encoding="UTF-8" ?>
<manifest>
    <remote name="TechnoLibre" fetch="https://github.com/TechnoLibre/" />

    <!-- Les jeux du Stream Deck et leur galerie, sur leur branche main :
         repo sync et le niveau Stream Deck d'install_erplibre_home.sh
         amènent leur dernier commit ; une installation gelée (FREEZE=1)
         prend le commit de freeze-revision. CONTRACT.md, à la racine du
         dépôt, dit ce que les jeux et ERPLibre attendent l'un de l'autre ;
         sa version MAJEURE est celle de script/stream_deck/games_contract,
         et test/test_streamdeck_games_repo.py échoue quand elles divergent.
         install_erplibre_home.sh ajoute ce projet au manifeste local ;
         repo sync l'amène. Le groupe est celui du programme du deck : les
         jeux viennent avec le niveau Stream Deck. -->
    <project
        name="streamdeck_game.git"
        path="script/stream_deck/games"
        remote="TechnoLibre"
        revision="main"
        freeze-revision="8522cde0770c59eb202ae32049047635c8ff79f5"
        groups="streamdeck"
    />
</manifest>
