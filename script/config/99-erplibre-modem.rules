# Reserve UN port AT du modem Quectel a ERPLibre, et un seul.
#
# Pourquoi pas ID_MM_DEVICE_IGNORE : ignorer tout l'appareil priverait
# ModemManager du modem, donc ERPLibre de l'etat qu'il en tire — carte SIM,
# operateur, qualite du signal, SMS. On perdrait plus qu'on ne gagne.
#
# Le modem expose DEUX ports AT. Mesure sur EC25-AF :
#   ttyUSB2  interface 02  ID_MM_PORT_TYPE_AT_PRIMARY
#   ttyUSB3  interface 03  ID_MM_PORT_TYPE_AT_SECONDARY
# On laisse le primaire a ModemManager et on prend le secondaire. Les deux
# repondent aux memes commandes ; se les partager evite d'arreter un service
# a chaque appel, ce qui coupait la connexion de donnees.
#
# Le groupe dialout et le mode 0660 evitent d'exiger les droits
# d'administration pour placer un appel : sudo a chaque appel serait
# intenable pour un service qui tourne seul.

ACTION=="add|change", SUBSYSTEM=="tty", \
  ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", \
  ENV{ID_USB_INTERFACE_NUM}=="03", \
  ENV{ID_MM_PORT_IGNORE}="1", \
  GROUP="dialout", MODE="0660", \
  SYMLINK+="erplibre-modem-at"

# La carte son apparait quand l'UAC est actif. Meme groupe, meme raison.
ACTION=="add|change", SUBSYSTEM=="sound", \
  ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", \
  GROUP="audio", MODE="0660"
