"""Lanceur de l'interface de l'installateur ERPLibre (erplibre_ui.py) :
écran Textual, ou mode texte sur une console série.

Les modules vivent dans SHARE_DIR, et ceux du profil machine dans
SHARE_DIR/machine, copiés là par build_iso.py. Aucun cache Python n'est
écrit à côté d'eux."""

import os
import sys

sys.dont_write_bytecode = True
SHARE_DIR = "/usr/local/share/erplibre-install"
for chemin in (os.path.join(SHARE_DIR, "machine"), SHARE_DIR):
    sys.path.insert(0, chemin)

import erplibre_ui  # noqa: E402

if __name__ == "__main__":
    sys.exit(erplibre_ui.main())
