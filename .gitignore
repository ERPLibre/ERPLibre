# Investigation notes, dated measurements and execution traces.
# UNVERSIONED ON PURPOSE: it holds what neither the code nor the commits
# may hold, customer data included. Ignoring it stops a blanket stage from
# sweeping it in.
/tasks/

# Binaire compile du service SIP : il se rebatit par l'installateur, et
# pese douze megaoctets.
/script/erplibre_sip_go/erplibre_sip_go

# Les jeux Stream Deck : un dépôt à part, cloné ici par Google Repo ou par
# install_erplibre_home.sh --stream-deck
# (manifest/git_manifest_streamdeck_game.xml).
/script/stream_deck/games/
# Ce que streamdeck_games_to_repo.sh met de côté (games.plain-clone-<date>,
# games.save-<date>), et le clone en cours de l'installateur (games.XXXXXX).
/script/stream_deck/games.*/
# L'ancien emplacement des sauvegardes des jeux, qu'un checkout garde tant
# qu'il ne les a pas déplacées dans games/save/.
script/stream_deck/save/
