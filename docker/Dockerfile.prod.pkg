# Les défauts suivent la version d'Odoo par défaut et la version d'ERPLibre :
# une construction lancée sans docker_build.sh prend la base publiée de cette
# version, et non celle d'une version d'ERPLibre passée. Un test les garde
# accordés à conf/supported_version_erplibre.json et .erplibre-semver-version.
ARG ERPLIBRE_IMAGE_NAME=1.8.0

FROM technolibre/erplibre-base:${ERPLIBRE_IMAGE_NAME}

ARG ERPLIBRE_VERSION=odoo18.0_python3.12.16
# ODOO_VERSION est herite de la base en ENV, et un ENV l'emporte toujours sur
# un ARG de meme nom : le redeclarer ici poserait une valeur inerte que
# l'image contredit sans le dire.
ARG POETRY_VERSION=2.5.1
ENV REPO_MANIFEST_URL=https://github.com/ERPLibre/ERPLibre
ARG WORKING_BRANCH
ARG WORKING_HASH
ENV BRANCH_ERPLIBRE=$WORKING_BRANCH
ENV COMMIT_ERPLIBRE=$WORKING_HASH
ENV DOCKER_BUILD=true
# Le compte propriétaire de /ERPLibre, son code et ses dépôts git : « odoo »,
# celui qui fait tourner Odoo, ou « root ». Sous « odoo »,
# erplibre_info_git_fetch tire le code depuis Odoo : un fetch écrit dans .git,
# et le processus d'Odoo peut donc réécrire son propre code. Sous « root »,
# l'image est immuable pour Odoo, et un tirage refuse en nommant le
# propriétaire. Tout ce qui écrit dans /ERPLibre s'exécute sous ce compte, de
# sorte que rien ne change de propriétaire après coup : un « chown -R »
# recopierait l'arbre entier dans une couche de plus.
ARG ERPLIBRE_CODE_OWNER=odoo
# Chaque dépôt est cloné sur le commit de son freeze-revision, et non sur la
# tête de sa branche : deux constructions du même commit d'ERPLibre donnent le
# même code. EL_FREEZE_STRICT refuse un projet sans freeze-revision avant que
# rien ne soit synchronisé. Les deux sont lus par le script qui génère le
# manifeste local, appelé plus bas directement et par la mise à jour de
# l'environnement ; en ARG, ils ne restent pas dans l'image.
# EL_FREEZE=0 (docker_build.sh --branches) suit les branches.
ARG EL_FREEZE=1
ARG EL_FREEZE_STRICT=1

RUN cat /etc/os-release

USER root

RUN case "${ERPLIBRE_CODE_OWNER}" in \
      odoo|root) ;; \
      *) echo "ERPLIBRE_CODE_OWNER vaut « odoo » ou « root », pas « ${ERPLIBRE_CODE_OWNER} »." ; exit 1 ;; \
    esac && \
    apt update && \
    apt install openssh-client git libgirepository1.0-dev -y --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

USER ${ERPLIBRE_CODE_OWNER}

RUN mkdir -p ~/.ssh/ && \
    echo "StrictHostKeyChecking no" >> ~/.ssh/config && \
    cd ; mkdir -p .bin/ && \
    git config --global color.ui false && \
    git config --global user.email "foo@bar.io" && \
    git config --global user.name "Foo Bar" && \
    if [ "$BRANCH_ERPLIBRE" = "HEAD" ]; then git clone $REPO_MANIFEST_URL $ODOO_PREFIX ; else git clone $REPO_MANIFEST_URL -b $BRANCH_ERPLIBRE $ODOO_PREFIX; fi && \
    cd $ODOO_PREFIX && \
    # fatal: detected dubious ownership in repository at '/ERPLibre'
    git config --global --add safe.directory /ERPLibre && \
    git checkout $COMMIT_ERPLIBRE

RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    python -m venv .venv.$ERPLIBRE_VERSION

# Le venv des outils prend le python de l'image, celui d'Odoo.
#
# Ses requis sont ceux de l'IMAGE et non ceux de l'hote : le fichier complet
# vise un venv en 3.15 et porte des bornes qu'un Python 3.7 ou 3.8 ne peut pas
# satisfaire, ce qui interdisait toute image d'Odoo 12 a 15.
#
# Le garde porte sur ce que l'image LANCE, et non sur tout script/ : compiler
# l'arbre entier alarmait sur des fichiers que l'image n'ouvre jamais. Importer
# les points d'entree suit le vrai graphe d'imports, donc un requis manquant
# comme une syntaxe trop recente s'arretent ici, avec le nom du coupable.
RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    python -m venv .venv.erplibre && \
    source ./.venv.erplibre/bin/activate && \
    pip3 install -r requirement/erplibre_require-ments-docker.txt && \
    { python -c "import script.version.update_env_version, script.git.git_merge_repo_manifest" || \
      { echo "Le python de l'image ($(python -V 2>&1)) ne fait pas tourner l'outillage : prendre une version Odoo plus recente." ; exit 1 ; } ; }

RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    curl https://storage.googleapis.com/git-repo-downloads/repo > .venv.erplibre/bin/repo && \
    chmod +x .venv.erplibre/bin/repo

RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    echo "${ERPLIBRE_VERSION}" && \
    source ./.venv.erplibre/bin/activate && \
    ./script/version/update_env_version.py --erplibre_version "${ERPLIBRE_VERSION}" --partial_install

RUN cd $ODOO_PREFIX && ls ./manifest -la && \
    ls  -lha /ERPLibre && \
    source ./.venv.erplibre/bin/activate && \
    ./script/manifest/update_manifest_local_dev.sh

# erplibre_info_git et erplibre_info_git_fetch lancent l'outillage git depuis
# Odoo, avec le venv des outils : là où les modules erplibre_info sont clonés,
# ses points d'entrée doivent s'importer, faute de quoi chaque instantané
# échoue dans le conteneur et non à la construction.
RUN cd $ODOO_PREFIX && \
    if [ -d "odoo${ODOO_VERSION}/addons/ERPLibre_erplibre_addons/erplibre_info" ]; then \
      ./.venv.erplibre/bin/python -c "import script.git.repo_state, script.git.repo_pull" || \
        { echo "erplibre_info_git* lance repo_state et repo_pull : un requis manque dans requirement/erplibre_require-ments-docker.txt." ; exit 1 ; } ; \
    fi

# Install Poetry
#
# CPPFLAGS redonne au preprocesseur l'alias Python 2 que SWIG 4.3 a retire.
# pykcs11 -- tire par endesive, dans les verrous d'Odoo 14, 15 et 17 -- ne
# livre aucun wrapper pre-genere et laisse Poetry prendre le DERNIER SWIG de
# PyPI ; son typemap CK_RV emploie PyInt_FromLong, et la compilation meurt.
# L'alias vit dans script/install/swig_compat.h, que lit aussi
# script/install/install_locally.sh : un test garde que les deux l'incluent.
RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    echo "${ERPLIBRE_VERSION}" && \
    source ./.venv.$(cat ".erplibre-version" | xargs)/bin/activate && \
    pip3 install --upgrade pip && git branch && ls . -lha && \
    pip3 install "poetry==${POETRY_VERSION}" && \
    poetry --version && \
    CPPFLAGS="${CPPFLAGS:+${CPPFLAGS} }-include ${PWD}/script/install/swig_compat.h" \
    poetry install --no-root -v

# Install local npm
RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    npm install

RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    mkdir -p "/ERPLibre/odoo${ODOO_VERSION}/addons/addons"

RUN cd $ODOO_PREFIX && \
    ls  -lha /ERPLibre && \
    head /etc/odoo/odoo.conf && \
    ./docker/repo_manifest_gen_org_prefix_path.py $ODOO_PREFIX/odoo${ODOO_VERSION}/addons /etc/odoo/odoo.conf /etc/odoo/odoo.conf && \
    head /etc/odoo/odoo.conf

USER root

RUN cp /etc/odoo/odoo.conf /odoo.conf

USER odoo

RUN mkdir -p '/home/odoo/.local/share/Odoo/'

ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
