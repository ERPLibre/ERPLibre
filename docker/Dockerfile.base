# syntax=docker/dockerfile:1

ARG PYTHON_VERSION=3.12.16
# trixie pour Odoo 16 à 18, bookworm pour 12 à 15 : docker_build.sh le choisit
# selon la version, faute d'image Python 3.7 ou 3.8 sur trixie.
ARG DEBIAN_NAME=trixie
FROM  python:${PYTHON_VERSION}-slim-${DEBIAN_NAME}
#MAINTAINER TechnoLibre <docker@technolibre.ca>

SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

# Generate locale C.UTF-8 for postgres and general locale data
ENV LANG=C.UTF-8

ENV LANG="C.UTF-8" \
    LC_ALL="C.UTF-8" \
    PATH="/opt/pyenv/shims:/opt/pyenv/bin:$PATH" \
    PYENV_ROOT="/opt/pyenv" \
    PYENV_SHELL="bash"

ENV ODOO_PREFIX=/ERPLibre

# La version d'Odoo vient de la construction. ODOO_EXEC_BIN la fige dans
# l'image et l'entrypoint lance ce chemin tel quel : sans ce ARG, le
# « --build-arg ODOO_VERSION » du script n'est consomme par personne et toute
# image, quelle que soit la version demandee, pointe sur odoo18.0 -- un chemin
# absent d'une image d'Odoo 15, donc un conteneur qui ne demarre pas.
ARG ODOO_VERSION=18.0
ENV ODOO_VERSION=${ODOO_VERSION}
ENV ODOO_EXEC_BIN="${ODOO_PREFIX}/odoo${ODOO_VERSION}/odoo/odoo-bin"

# Posée par BuildKit selon la plateforme construite : amd64, arm64, s390x… ;
# dpkg la donne sous le même nom quand un constructeur sans BuildKit la tait.
ARG TARGETARCH

# wkhtmltopdf au Qt patché, le seul qui pose en-tête et pied de page dans les
# PDF d'Odoo. Son build bookworm sert aussi sur trixie, qui n'en publie pas :
# les paquets « t64 » de trixie fournissent encore libssl3 et libpng16-16 qu'il
# réclame. Seuls amd64 et arm64 ont un build ; Debian trixie a retiré le
# paquet wkhtmltopdf. Ailleurs, l'image se construit sans lui et Odoo
# n'imprime ses rapports qu'en HTML. L'empreinte de chaque .deb est vérifiée
# avant de l'installer : une page d'erreur s'installerait sinon comme paquet.
ARG WKHTMLTOX_VERSION=0.12.6.1-3

# Install some deps, lessc and less-plugin-clean-css, and wkhtmltopdf
#
# vim n'y est pas : il dépend, à la version près, de vim-common, commun à
# toutes les architectures, et un correctif de sécurité publié avant le
# binaire d'une architecture rend son installation impossible là, ce qui
# arrête toute la construction.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    build-essential \
    bzip2 \
    ca-certificates \
    cmake \
    curl \
    dirmngr \
    fonts-noto-cjk \
    git \
    gnupg \
    htop \
    inetutils-ping \
    iproute2 \
    libbz2-dev \
    libcairo2-dev \
    libcups2-dev \
    libffi-dev \
    libgdbm-compat-dev \
    libgdbm-dev \
    libldap2-dev \
    liblzma-dev \
    libmariadbd-dev \
    libncurses-dev \
    libreadline-dev \
    libsasl2-dev \
    libsqlite3-dev \
    libssl-dev \
    libxslt1-dev \
    libzip-dev \
    llvm \
    make \
    npm \
    openssl \
    portaudio19-dev \
    shfmt \
    sqlite3 \
    swig \
    tig \
    tk-dev \
    tree \
    uuid-dev \
    wget \
    xmlsec1 \
    xz-utils \
    zlib1g-dev \
    && arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "${arch}" in \
         amd64) wk_sha1=e9f95436298c77cc9406bd4bbd242f4771d0a4b2 ;; \
         arm64) wk_sha1=77bc06be5e543510140e6728e11b7c22504080d4 ;; \
         *) wk_sha1="" ;; \
       esac \
    && if [ -n "${wk_sha1}" ]; then \
         curl -o wkhtmltox.deb -sSL "https://github.com/wkhtmltopdf/packaging/releases/download/${WKHTMLTOX_VERSION}/wkhtmltox_${WKHTMLTOX_VERSION}.bookworm_${arch}.deb" \
         && echo "${wk_sha1} wkhtmltox.deb" | sha1sum -c - \
         && apt-get install -y --no-install-recommends ./wkhtmltox.deb \
         && wkhtmltopdf --version ; \
       else \
         echo "wkhtmltopdf : aucun build pour ${arch}, les rapports d'Odoo resteront en HTML." ; \
       fi \
    && rm -rf /var/lib/apt/lists/* wkhtmltox.deb

ARG DEBIAN_NAME

# Le client PostgreSQL 18 vient du dépôt pgdg, qui ne publie qu'amd64 et arm64
# parmi les plateformes construites. Ailleurs, le client est celui de Debian,
# 17 sur trixie : son pg_dump refuse un serveur plus récent que lui. La clé du
# dépôt ne vaut que pour lui (signed-by), et non pour tous les dépôts d'apt.
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "${arch}" in \
      amd64|arm64) \
        GNUPGHOME="$(mktemp -d)" \
        && export GNUPGHOME \
        && repokey='B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8' \
        && gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "${repokey}" \
        && gpg --batch --armor --export "${repokey}" > /usr/share/keyrings/pgdg.asc \
        && gpgconf --kill all \
        && rm -rf "$GNUPGHOME" \
        && echo "deb [signed-by=/usr/share/keyrings/pgdg.asc] http://apt.postgresql.org/pub/repos/apt/ ${DEBIAN_NAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
        && client=postgresql-client-18 ;; \
      *) client=postgresql-client ;; \
    esac \
    && apt-get update \
    && apt-get install --no-install-recommends -y "${client}" libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# PyPI publie des wheels amd64 et arm64 pour chaque dépendance native du lock,
# pas s390x : Poetry y compile bcrypt, cryptography et orjson en Rust, scipy
# en Fortran sur BLAS, shapely, pyproj et pikepdf sur GEOS, PROJ et qpdf,
# manifold3d sur TBB. grpcio embarque BoringSSL, qui ne connaît pas s390x : la
# variable le branche sur l'OpenSSL du système, et n'agit que sur une
# compilation, jamais sur un wheel. pynacl garde sa libsodium embarquée, celle
# de Debian n'ayant pas les fonctions qu'il appelle.
#
# Le rustc de Debian est trop ancien pour orjson : Rust vient de rustup, à la
# version épinglée, et rustup-init est vérifié par son empreinte. rustc et
# cargo sont liés dans /usr/local/bin, sans CARGO_HOME commun : le cache des
# crates reste celui du compte qui compile.
ENV GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=1
ARG RUSTUP_VERSION=1.29.2
ARG RUST_VERSION=1.99.1
RUN arch="${TARGETARCH:-$(dpkg --print-architecture)}" \
    && case "${arch}" in \
      amd64|arm64) ;; \
      *) \
        case "${arch}" in \
          s390x) rustup_sha256=c60999321d0363f6e4d75b646f59ba25feb41b20f872ffb3a46b9a9aea6da1fc ;; \
          *) echo "rustup : aucune empreinte pour ${arch}." >&2 ; exit 1 ;; \
        esac \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
        gfortran \
        libgeos-dev \
        libjpeg-dev \
        libopenblas-dev \
        libproj-dev \
        libqpdf-dev \
        libtbb-dev \
        pkgconf \
        proj-bin \
        && rm -rf /var/lib/apt/lists/* \
        && triple="${arch}-unknown-linux-gnu" \
        && curl -o /tmp/rustup-init -sSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${triple}/rustup-init" \
        && echo "${rustup_sha256} /tmp/rustup-init" | sha256sum -c - \
        && chmod +x /tmp/rustup-init \
        && CARGO_HOME=/tmp/cargo RUSTUP_HOME=/opt/rustup /tmp/rustup-init -y \
             --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}" \
        && ln -s "/opt/rustup/toolchains/${RUST_VERSION}-${triple}/bin/rustc" \
                 "/opt/rustup/toolchains/${RUST_VERSION}-${triple}/bin/cargo" /usr/local/bin/ \
        && rm -rf /tmp/rustup-init /tmp/cargo \
        && rustc --version && cargo --version ;; \
    esac

# Install npm dependencies
RUN npm install -g rtlcss less prettier @prettier/plugin-xml \
    && ln -fs /usr/local/bin/lessc /usr/bin/lessc

# Install git-repo
RUN cd ; mkdir -p .bin/ && \
    git config --global color.ui false   && \
    git config --global user.email "foo@bar.io" && \
    git config --global user.name "Foo Bar" && \
    curl https://storage.googleapis.com/git-repo-downloads/repo > /usr/bin/repo && \
    chmod +x /usr/bin/repo  && sed -i '1 s/python$/python3/' /usr/bin/repo

RUN groupadd --gid 101  --force odoo && \
        useradd --non-unique --create-home --uid 101 --gid 101 odoo

# Copy entrypoint script and Odoo configuration file
COPY ./entrypoint.sh /
RUN  chmod +x /entrypoint.sh

# Set the default config file
ENV ODOO_RC=/etc/odoo/odoo.conf
COPY ./odoo.conf $ODOO_RC
RUN chown odoo $ODOO_RC

RUN mkdir $ODOO_PREFIX && \
    chown odoo $ODOO_PREFIX && \
    chmod 1777 $ODOO_PREFIX

# Mount /var/lib/odoo to allow restoring filestore
RUN chown odoo $ODOO_RC

# Expose Odoo services
EXPOSE 8069 8071 8072

#RUN mkdir -p /var/lib/odoo && \
#    chown odoo /var/lib/odoo && \
#    chmod 1777 /var/lib/odoo

# VOLUME /var/lib/odoo

# Set default user when running the container
USER odoo

ENTRYPOINT ["/entrypoint.sh"]
CMD ["odoo"]
